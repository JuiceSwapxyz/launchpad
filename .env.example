# Private key for deployment (DO NOT commit .env file!)
PRIVATE_KEY=your_private_key_here

# Citrea RPC endpoints
CITREA_TESTNET_RPC=https://rpc.testnet.citrea.xyz
CITREA_MAINNET_RPC=https://rpc.citrea.xyz

# Uniswap V2 addresses on Citrea (JuiceSwap)
UNISWAP_V2_FACTORY=
UNISWAP_V2_ROUTER=

# Base asset address on Citrea (JUSD - Juice Dollar)
# All tokens created by the launchpad will trade against this asset
BASE_ASSET_ADDRESS=

# Fee recipient address (receives protocol fees from token graduations)
# Optional: Defaults to deployer address if not set
# Recommended: Use a multisig or treasury address for mainnet
# Expected revenue: ~129 JUSD per token graduation (1% of ~12,750 JUSD traded)
FEE_RECIPIENT=

# Block explorer API key (if available)
BLOCK_EXPLORER_API_KEY=
