# Deployment
PRIVATE_KEY=

# Citrea RPC
CITREA_TESTNET_RPC=https://rpc.testnet.citreascan.com
CITREA_MAINNET_RPC=https://rpc.citreascan.com

# =============================================================================
# NOTE: Most addresses are now imported automatically from packages!
#
# The deploy script imports from:
#   - @juicedollar/jusd      → JUSD address (base asset)
#   - @juiceswapxyz/sdk-core → V2 Router, V2 Factory, INIT_CODE_HASH
#
# You only need to set FEE_RECIPIENT if you want a different address.
# =============================================================================

# Optional
FEE_RECIPIENT=                     # Defaults to deployer
INITIAL_VIRTUAL_BASE=4500          # Virtual base reserves in JUSD

# Integration Testing (set after deployment)
FACTORY_ADDRESS=                   # Deployed TokenFactory address
